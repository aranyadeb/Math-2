# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never exposed to the browser. Currently optional (reserved for admin scripts).
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (server-only)
GEMINI_API_KEY=

GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_REASONING_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# Optional tuning
# Confidence below this escalates graph generation to the reasoning model.
GEMINI_ESCALATION_CONFIDENCE=0.7
# USD per 1M tokens, used only for the usage estimator.
GEMINI_FAST_PRICE_IN=0.10
GEMINI_FAST_PRICE_OUT=0.40
GEMINI_REASONING_PRICE_IN=0.30
GEMINI_REASONING_PRICE_OUT=2.50
