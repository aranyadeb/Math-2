{"k":"dif","t":"Differentiation","cls":"12","u":"Calculus","s":[["Standard derivatives",[{"q":"Power, exponential, log","f":"\\frac{d}{dx}x^n=nx^{n-1},\\quad\\frac{d}{dx}e^x=e^x,\\quad\\frac{d}{dx}a^x=a^x\\ln a,\\quad\\frac{d}{dx}\\ln x=\\frac1x","n":"$\\frac{d}{dx}\\log_a x=\\frac1{x\\ln a}$; $\\frac{d}{dx}\\ln|x|=\\frac1x$."},{"q":"Trigonometric derivatives","f":"(\\sin x)'=\\cos x,\\ (\\cos x)'=-\\sin x,\\ (\\tan x)'=\\sec^2x,\\ (\\cot x)'=-\\csc^2x,\\ (\\sec x)'=\\sec x\\tan x,\\ (\\csc x)'=-\\csc x\\cot x","d":"$\\frac{\\sin(x+h)-\\sin x}h=\\frac{2\\cos(x+\\frac h2)\\sin\\frac h2}{h}\\to\\cos x$."},{"q":"Inverse trigonometric derivatives","f":"(\\sin^{-1}x)'=\\frac1{\\sqrt{1-x^2}},\\ (\\cos^{-1}x)'=-\\frac1{\\sqrt{1-x^2}},\\ (\\tan^{-1}x)'=\\frac1{1+x^2}","n":"$(\\cot^{-1}x)'=-\\frac1{1+x^2}$, $(\\sec^{-1}x)'=\\frac1{|x|\\sqrt{x^2-1}}$, $(\\csc^{-1}x)'=-\\frac1{|x|\\sqrt{x^2-1}}$."},{"q":"Derivative of $|x|$","f":"\\frac{d}{dx}|x|=\\frac{|x|}x=\\frac x{|x|},\\quad x\\ne0"}]],["Rules",[{"q":"Product and quotient rules","f":"(uv)'=u'v+uv',\\qquad\\left(\\frac uv\\right)'=\\frac{u'v-uv'}{v^2}","n":"$(uvw)'=u'vw+uv'w+uvw'$."},{"q":"Chain rule","f":"\\frac{dy}{dx}=\\frac{dy}{du}\\cdot\\frac{du}{dx}"},{"q":"Parametric differentiation","f":"\\frac{dy}{dx}=\\frac{dy/dt}{dx/dt},\\qquad\\frac{d^2y}{dx^2}=\\frac{d}{dt}\\left(\\frac{dy}{dx}\\right)\\Big/\\frac{dx}{dt}"},{"q":"Implicit differentiation","f":"F(x,y)=0\\Rightarrow\\frac{dy}{dx}=-\\frac{F_x}{F_y}"},{"q":"Logarithmic differentiation","f":"y=u^v\\Rightarrow\\frac{dy}{dx}=u^v\\left(v'\\ln u+\\frac{vu'}u\\right)"},{"q":"Derivative of inverse function","f":"\\frac{dx}{dy}=\\frac1{dy/dx},\\qquad\\frac{d^2x}{dy^2}=-\\frac{d^2y/dx^2}{(dy/dx)^3}"},{"q":"Leibniz rule for the n-th derivative of a product","f":"(uv)^{(n)}=\\sum_{r=0}^n{}^nC_r\\,u^{(n-r)}v^{(r)}"},{"q":"Differentiation under the integral sign (Leibniz)","f":"\\frac{d}{dx}\\int_{g(x)}^{h(x)}f(t)\\,dt=f(h(x))h'(x)-f(g(x))g'(x)"}]],["n-th derivatives",[{"q":"Standard n-th derivatives","f":"\\frac{d^n}{dx^n}e^{ax}=a^ne^{ax},\\quad\\frac{d^n}{dx^n}\\sin(ax+b)=a^n\\sin\\left(ax+b+\\frac{n\\pi}2\\right)","n":"$\\frac{d^n}{dx^n}\\frac1{ax+b}=\\frac{(-1)^nn!\\,a^n}{(ax+b)^{n+1}}$; $\\frac{d^n}{dx^n}\\ln(ax+b)=\\frac{(-1)^{n-1}(n-1)!\\,a^n}{(ax+b)^n}$."}]],["Common results",[{"q":"Substitution tricks","f":"\\sqrt{1-x^2}\\to x=\\sin\\theta;\\quad1+x^2\\to x=\\tan\\theta;\\quad\\frac{1-x}{1+x}\\to x=\\cos2\\theta","n":"E.g. $\\frac{d}{dx}\\tan^{-1}\\frac{2x}{1-x^2}=\\frac2{1+x^2}$ for $|x|<1$."},{"q":"Infinite radical / power towers","f":"y=\\sqrt{f+\\sqrt{f+\\cdots}}\\Rightarrow y^2=f+y\\Rightarrow\\frac{dy}{dx}=\\frac{f'}{2y-1}","n":"$y=x^{x^{x^{\\cdots}}}\\Rightarrow y=x^y\\Rightarrow\\frac{dy}{dx}=\\frac{y^2}{x(1-y\\ln x)}$."},{"q":"Derivative of one function w.r.t. another","f":"\\frac{du}{dv}=\\frac{du/dx}{dv/dx}"},{"q":"Derivative of the inverse function at a point","f":"g=f^{-1}\\Rightarrow g'(f(a))=\\frac1{f'(a)}"}]]]}