{"k":"log","t":"Logarithms, Modulus & Inequalities","cls":"11","u":"Algebra","s":[["Logarithm basics",[{"q":"Definition of logarithm","f":"\\log_a x = y \\iff a^y = x","n":"$a>0,\\ a\\ne 1,\\ x>0$.","h":"\"log is the exponent\"."},{"q":"Log of a product","f":"\\log_a(mn)=\\log_a m+\\log_a n","n":"$m,n>0$.","d":"Let $m=a^p,\\ n=a^q$. Then $mn=a^{p+q}$, so $\\log_a(mn)=p+q$."},{"q":"Log of a quotient","f":"\\log_a\\frac{m}{n}=\\log_a m-\\log_a n","n":"$m,n>0$."},{"q":"Log of a power","f":"\\log_a m^k = k\\log_a m","n":"For even $k$ with $m<0$: $\\log_a m^{2} = 2\\log_a|m|$."},{"q":"Change of base","f":"\\log_a b=\\frac{\\log_c b}{\\log_c a}=\\frac{\\ln b}{\\ln a}","n":"$c>0,\\ c\\ne1$.","d":"Let $\\log_a b=y \\Rightarrow a^y=b$. Take $\\log_c$: $y\\log_c a=\\log_c b$."},{"q":"Reciprocal property","f":"\\log_a b\\cdot\\log_b a=1","n":"Also $\\log_a b\\cdot\\log_b c\\cdot\\log_c d=\\log_a d$ (chain rule of logs)."},{"q":"Base-power rule","f":"\\log_{a^q} b^p=\\frac{p}{q}\\log_a b","n":"$q\\ne0$."},{"q":"Exponent–log identity","f":"a^{\\log_a x}=x,\\qquad a^{\\log_b c}=c^{\\log_b a}","d":"Take $\\log_b$ of both sides of the second: $\\log_b c\\cdot\\log_b a$ on each side."},{"q":"Special values","f":"\\log_a 1=0,\\quad \\log_a a=1,\\quad \\log_{1/a} x=-\\log_a x"},{"q":"Monotonicity of log","f":"a>1:\\ x_1<x_2\\iff\\log_a x_1<\\log_a x_2;\\qquad 0<a<1:\\ \\text{inequality reverses}","h":"Base below 1 flips the sign."},{"q":"Number of digits of $N$","f":"\\text{digits}(N)=\\lfloor\\log_{10}N\\rfloor+1","n":"Number of zeros after decimal before first significant digit of $0<N<1$: $|\\lfloor\\log_{10}N\\rfloor|-1$."}]],["Modulus",[{"q":"Definition of $|x|$","f":"|x|=\\begin{cases}x,&x\\ge0\\\\-x,&x<0\\end{cases},\\qquad |x|=\\sqrt{x^2}"},{"q":"Basic modulus inequalities","f":"|x|<a\\iff -a<x<a;\\qquad |x|>a\\iff x<-a\\ \\text{or}\\ x>a","n":"$a>0$."},{"q":"Triangle inequality","f":"\\big||a|-|b|\\big|\\le|a\\pm b|\\le|a|+|b|","n":"$|a+b|=|a|+|b|\\iff ab\\ge0$; $|a-b|=|a|+|b|\\iff ab\\le0$."},{"q":"Product and quotient of modulus","f":"|ab|=|a||b|,\\qquad \\left|\\frac ab\\right|=\\frac{|a|}{|b|}"}]],["Greatest integer and fractional part",[{"q":"Greatest integer function","f":"[x]=n \\iff n\\le x<n+1,\\ n\\in\\mathbb Z;\\qquad x-1<[x]\\le x","n":"$\\{x\\}=x-[x]\\in[0,1)$."},{"q":"Properties of $[x]$","f":"[x+n]=[x]+n;\\quad [x]+[-x]=\\begin{cases}0,&x\\in\\mathbb Z\\\\-1,&x\\notin\\mathbb Z\\end{cases}","n":"$\\{x\\}+\\{-x\\}=0$ if $x\\in\\mathbb Z$, else $1$."},{"q":"Hermite's identity","f":"[x]+\\left[x+\\tfrac1n\\right]+\\cdots+\\left[x+\\tfrac{n-1}{n}\\right]=[nx]","n":"Special case: $[x]+[x+\\tfrac12]=[2x]$."}]],["Mean inequalities",[{"q":"AM ≥ GM ≥ HM (two numbers)","f":"\\frac{a+b}{2}\\ge\\sqrt{ab}\\ge\\frac{2ab}{a+b}","n":"$a,b>0$; equality iff $a=b$. Also $G^2=AH$ for two numbers.","d":"$\\frac{a+b}{2}-\\sqrt{ab}=\\frac{(\\sqrt a-\\sqrt b)^2}{2}\\ge0$."},{"q":"AM ≥ GM ≥ HM (n numbers)","f":"\\frac{a_1+\\cdots+a_n}{n}\\ge\\sqrt[n]{a_1\\cdots a_n}\\ge\\frac{n}{\\frac1{a_1}+\\cdots+\\frac1{a_n}}","n":"All $a_i>0$; equality iff all equal."},{"q":"Weighted AM–GM","f":"\\frac{w_1a_1+\\cdots+w_na_n}{w_1+\\cdots+w_n}\\ge\\left(a_1^{w_1}\\cdots a_n^{w_n}\\right)^{1/(w_1+\\cdots+w_n)}"},{"q":"Power mean (RMS ≥ AM)","f":"\\sqrt{\\frac{a_1^2+\\cdots+a_n^2}{n}}\\ge\\frac{a_1+\\cdots+a_n}{n}"},{"q":"m-th power mean inequality","f":"\\frac{a_1^m+\\cdots+a_n^m}{n}\\ \\gtrless\\ \\left(\\frac{a_1+\\cdots+a_n}{n}\\right)^m","n":"$>$ if $m<0$ or $m>1$; $<$ if $0<m<1$ (all $a_i>0$, not all equal)."},{"q":"Cauchy–Schwarz inequality","f":"(a_1b_1+\\cdots+a_nb_n)^2\\le(a_1^2+\\cdots+a_n^2)(b_1^2+\\cdots+b_n^2)","n":"Equality iff $\\frac{a_1}{b_1}=\\cdots=\\frac{a_n}{b_n}$."},{"q":"Sum of a number and its reciprocal","f":"x+\\frac1x\\ge2\\ (x>0),\\qquad x+\\frac1x\\le-2\\ (x<0)"}]],["Wavy curve method",[{"q":"Sign scheme of a rational function","f":"f(x)=\\frac{(x-a_1)^{k_1}\\cdots}{(x-b_1)^{m_1}\\cdots}:\\ \\text{sign changes at a root of odd multiplicity only}","n":"Mark critical points, start with $+$ on the far right (leading coefficient positive), flip sign only across odd-multiplicity points; exclude zeros of the denominator."}]]]}