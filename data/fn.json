{"k":"fn","t":"Sets, Relations & Functions","cls":"11","u":"Calculus","s":[["Sets and relations",[{"q":"Cardinality of union","f":"n(A\\cup B)=n(A)+n(B)-n(A\\cap B)","n":"Three sets: $n(A\\cup B\\cup C)=\\sum n(A)-\\sum n(A\\cap B)+n(A\\cap B\\cap C)$."},{"q":"De Morgan's laws","f":"(A\\cup B)'=A'\\cap B',\\qquad(A\\cap B)'=A'\\cup B'"},{"q":"Distributive laws and differences","f":"A\\cap(B\\cup C)=(A\\cap B)\\cup(A\\cap C);\\qquad A-B=A\\cap B'"},{"q":"Number of subsets and relations","f":"|P(A)|=2^n;\\qquad\\#\\text{relations } A\\to B=2^{mn}","n":"Reflexive relations on an $n$-set: $2^{n^2-n}$; symmetric: $2^{\\frac{n(n+1)}2}$."},{"q":"Types of relations","f":"\\text{reflexive: }(a,a)\\in R;\\ \\text{symmetric: }(a,b)\\Rightarrow(b,a);\\ \\text{transitive: }(a,b),(b,c)\\Rightarrow(a,c)","n":"Equivalence = all three; it partitions the set into equivalence classes."}]],["Function basics",[{"q":"Number of functions from A to B","f":"|A|=m,\\ |B|=n:\\ \\text{functions}=n^m,\\quad\\text{one-one}={}^nP_m\\ (m\\le n)","n":"Onto ($m\\ge n$): $\\sum_{k=0}^n(-1)^k\\binom nk(n-k)^m$. Bijections when $m=n$: $n!$."},{"q":"Test for one-one and onto","f":"f'(x)\\ \\text{of constant sign}\\Rightarrow\\text{one-one};\\qquad\\text{onto}\\iff\\text{range}=\\text{codomain}","n":"Horizontal line test."},{"q":"Even and odd functions","f":"f(-x)=f(x)\\ (\\text{even, symmetric about }y\\text{-axis}),\\qquad f(-x)=-f(x)\\ (\\text{odd, about origin})","n":"Every function $=\\frac{f(x)+f(-x)}2+\\frac{f(x)-f(-x)}2$."},{"q":"Periodic functions","f":"f(x+T)=f(x);\\quad\\text{period of } f(ax+b)=\\frac T{|a|}","n":"$\\sin^n x,\\cos^n x$: period $\\pi$ for $n$ even, $2\\pi$ for $n$ odd; $|\\sin x|+|\\cos x|$: $\\frac\\pi2$. Period of a sum = LCM of periods (if it exists). $\\{x\\}$: period $1$."},{"q":"Composition and inverse","f":"(f\\circ g)(x)=f(g(x));\\qquad f^{-1}\\ \\text{exists}\\iff f\\ \\text{bijective};\\quad(f\\circ g)^{-1}=g^{-1}\\circ f^{-1}","n":"Graph of $f^{-1}$ is the mirror of $f$ in $y=x$; $f$ and $f^{-1}$ meet on $y=x$ when $f$ is increasing."},{"q":"Domain rules","f":"\\sqrt{f}:f\\ge0;\\quad\\frac1f:f\\ne0;\\quad\\log f:f>0;\\quad\\sin^{-1}f:|f|\\le1"}]],["Standard graphs",[{"q":"Modulus function","f":"y=|x|","g":"y=abs(x) ; -4,4,-1,4"},{"q":"Greatest integer function","f":"y=[x],\\ \\text{discontinuous at integers}","g":"y=floor(x) ; -3.5,3.5,-3.5,3.5"},{"q":"Fractional part function","f":"y=\\{x\\}=x-[x]\\in[0,1)","g":"y=x-floor(x) ; -3,3,-0.5,1.5"},{"q":"Signum function","f":"\\operatorname{sgn}x=\\begin{cases}1,&x>0\\\\0,&x=0\\\\-1,&x<0\\end{cases}","g":"y=sign(x) ; -3,3,-1.6,1.6"},{"q":"Exponential and logarithm","f":"y=e^x\\ (\\text{range }(0,\\infty)),\\qquad y=\\ln x\\ (\\text{domain }(0,\\infty))","g":"y=exp(x) | y=log(x) | y=x ; -3,4,-3,4"},{"q":"Polynomial and reciprocal curves","f":"y=x^2,\\quad y=x^3,\\quad y=\\frac1x,\\quad y=\\frac1{x^2}","g":"y=x**2 | y=x**3 | y=1/x ; -3,3,-3,3"},{"q":"Square root and cube root","f":"y=\\sqrt x\\ (x\\ge0),\\qquad y=\\sqrt[3]x\\ (x\\in\\mathbb R)","g":"y=sqrt(x) | y=cbrt(x) ; -4,4,-2,2.5"},{"q":"Transformations of graphs","f":"y=f(x)+k\\ (\\text{up}),\\ f(x-h)\\ (\\text{right}),\\ -f(x)\\ (\\text{flip in }x\\text{-axis}),\\ f(-x)\\ (\\text{flip in }y\\text{-axis}),\\ f(ax)\\ (\\text{squeeze})","n":"$|f(x)|$: reflect the negative part up. $f(|x|)$: keep the right half, mirror it to the left.","g":"y=sin(x) | y=abs(sin(x)) | y=sin(abs(x)) ; -6.5,6.5,-1.5,1.5"}]],["Common results",[{"q":"Functional equations","f":"f(x+y)=f(x)+f(y)\\Rightarrow f(x)=kx;\\quad f(xy)=f(x)+f(y)\\Rightarrow k\\ln x;\\quad f(x+y)=f(x)f(y)\\Rightarrow a^x","n":"$f(x)+f\\left(\\frac1x\\right)=f(x)f\\left(\\frac1x\\right)\\Rightarrow f(x)=1\\pm x^n$."},{"q":"Max and min functions","f":"\\max(a,b)=\\frac{a+b+|a-b|}2,\\qquad\\min(a,b)=\\frac{a+b-|a-b|}2"},{"q":"Range by AM–GM, quadratic in $x$, or monotonicity","f":"y=f(x)\\Rightarrow\\text{solve for } x,\\ \\text{require real } x"},{"q":"$f(x)=f^{-1}(x)$ shortcut","f":"f\\ \\text{increasing}:\\ f(x)=f^{-1}(x)\\iff f(x)=x"}]]]}