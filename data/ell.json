{"k":"ell","t":"Ellipse","cls":"11","u":"Coordinate Geometry","s":[["Standard ellipse",[{"q":"Standard ellipse ($a>b$)","f":"\\frac{x^2}{a^2}+\\frac{y^2}{b^2}=1,\\quad b^2=a^2(1-e^2)","g":"p=2*cos(t),1.2*sin(t),0,2*pi ; -3,3,-2,2","n":"Foci $(\\pm ae,0)$, directrices $x=\\pm\\frac ae$, latus rectum $\\frac{2b^2}a$, major axis $2a$, minor axis $2b$."},{"q":"Ellipse with major axis along $y$ ($b>a$)","f":"\\frac{x^2}{a^2}+\\frac{y^2}{b^2}=1,\\ b>a:\\ a^2=b^2(1-e^2),\\ \\text{foci }(0,\\pm be)"},{"q":"Focal distances","f":"SP=a-ex_1,\\quad S'P=a+ex_1,\\quad SP+S'P=2a"},{"q":"Parametric point (eccentric angle)","f":"(a\\cos\\theta,\\ b\\sin\\theta)","n":"Auxiliary circle $x^2+y^2=a^2$."},{"q":"Position of a point","f":"S_1=\\frac{x_1^2}{a^2}+\\frac{y_1^2}{b^2}-1:\\ <0\\ \\text{inside},\\ =0\\ \\text{on},\\ >0\\ \\text{outside}"}]],["Chords",[{"q":"Chord joining $\\alpha,\\beta$","f":"\\frac xa\\cos\\frac{\\alpha+\\beta}2+\\frac yb\\sin\\frac{\\alpha+\\beta}2=\\cos\\frac{\\alpha-\\beta}2","n":"Focal chord condition: $\\tan\\frac\\alpha2\\tan\\frac\\beta2=\\frac{e-1}{e+1}$ (through $(ae,0)$)."},{"q":"Chord with given midpoint, chord of contact, pair of tangents","f":"T=S_1,\\qquad T=0,\\qquad SS_1=T^2"}]],["Tangents and normals",[{"q":"Tangent at $(x_1,y_1)$ and at $\\theta$","f":"\\frac{xx_1}{a^2}+\\frac{yy_1}{b^2}=1;\\qquad\\frac{x\\cos\\theta}a+\\frac{y\\sin\\theta}b=1"},{"q":"Slope form and tangency condition","f":"y=mx\\pm\\sqrt{a^2m^2+b^2};\\qquad c^2=a^2m^2+b^2","n":"Point of contact $\\left(\\frac{\\mp a^2m}{\\sqrt{a^2m^2+b^2}},\\frac{\\pm b^2}{\\sqrt{a^2m^2+b^2}}\\right)$."},{"q":"Normal at $(x_1,y_1)$ and at $\\theta$","f":"\\frac{a^2x}{x_1}-\\frac{b^2y}{y_1}=a^2-b^2;\\qquad ax\\sec\\theta-by\\csc\\theta=a^2-b^2"},{"q":"Slope form of normal","f":"y=mx\\mp\\frac{(a^2-b^2)m}{\\sqrt{a^2+b^2m^2}}"},{"q":"Director circle","f":"x^2+y^2=a^2+b^2"},{"q":"Reflection property","f":"\\text{the tangent and normal bisect the angles between the focal radii}"},{"q":"Product of perpendiculars from foci to a tangent","f":"p_1p_2=b^2","n":"Foot of perpendicular from a focus to a tangent lies on the auxiliary circle."}]],["Common results",[{"q":"Area of ellipse","f":"A=\\pi ab"},{"q":"Conormal points","f":"\\text{up to 4 normals from a point};\\ \\ \\alpha+\\beta+\\gamma+\\delta=(2n+1)\\pi","n":"Eccentric angles of the feet of co-normal points."},{"q":"Concyclic points on an ellipse","f":"\\alpha+\\beta+\\gamma+\\delta=2n\\pi"},{"q":"Conjugate diameters","f":"m_1m_2=-\\frac{b^2}{a^2};\\quad\\text{eccentric angles differ by }\\tfrac\\pi2;\\quad CP^2+CD^2=a^2+b^2"},{"q":"Locus of the point of intersection of perpendicular tangents","f":"\\text{director circle } x^2+y^2=a^2+b^2"},{"q":"Maximum area of triangle inscribed / ellipse tricks","f":"\\text{max area of inscribed triangle}=\\frac{3\\sqrt3}4ab","n":"Obtained from an equilateral triangle in the auxiliary circle compressed by $\\frac ba$."},{"q":"Length of the latus rectum and semi-latus rectum","f":"\\frac{2b^2}a;\\qquad\\frac1{SP}+\\frac1{SQ}=\\frac{2a}{b^2}\\ (\\text{focal chord } PQ)"}]]]}