{"k":"pnc","t":"Permutations & Combinations","cls":"11","u":"Algebra","s":[["Basics",[{"q":"Factorial and permutations","f":"{}^nP_r=\\frac{n!}{(n-r)!},\\qquad 0!=1","n":"Number of arrangements of $r$ out of $n$ distinct objects."},{"q":"Combinations","f":"{}^nC_r=\\binom nr=\\frac{n!}{r!(n-r)!}","n":"${}^nP_r=r!\\,{}^nC_r$."},{"q":"Properties of $^nC_r$","f":"{}^nC_r={}^nC_{n-r},\\qquad {}^nC_r+{}^nC_{r-1}={}^{n+1}C_r","n":"${}^nC_x={}^nC_y\\Rightarrow x=y$ or $x+y=n$."},{"q":"Other identities","f":"\\frac{{}^nC_r}{{}^nC_{r-1}}=\\frac{n-r+1}{r},\\qquad r\\,{}^nC_r=n\\,{}^{n-1}C_{r-1}","n":"${}^nC_r$ is greatest at $r=\\frac n2$ ($n$ even) or $r=\\frac{n\\pm1}2$ ($n$ odd)."},{"q":"Hockey-stick identity","f":"\\sum_{k=r}^{n}{}^kC_r={}^{n+1}C_{r+1}"}]],["Arrangements",[{"q":"Permutations with repetition allowed","f":"n^r"},{"q":"Permutations of identical objects","f":"\\frac{n!}{p!\\,q!\\,r!\\cdots}","n":"$p$ alike of one kind, $q$ alike of another, etc."},{"q":"Circular permutations","f":"(n-1)!;\\qquad \\text{necklace/garland (flip same)}:\\ \\frac{(n-1)!}{2}","n":"Choose $r$ of $n$ in a circle: $\\frac{{}^nP_r}{r}$."},{"q":"Things always together / never together","f":"\\text{together: treat as one unit};\\quad\\text{never together} = \\text{total} - \\text{together}","n":"Gap method: arrange others first, then place the restricted items in the gaps."},{"q":"Rank of a word in dictionary order","f":"\\text{rank}=1+\\sum(\\text{count of words starting with smaller letters at each position})"}]],["Selections",[{"q":"At least one from n distinct objects","f":"2^n-1"},{"q":"Selection from identical objects","f":"(p+1)(q+1)(r+1)\\cdots-1","n":"$p$ alike, $q$ alike, … at least one selected. Add $\\times 2^k$ for $k$ distinct ones."},{"q":"Number of divisors of $N=p^aq^br^c$","f":"(a+1)(b+1)(c+1);\\qquad \\text{sum}=\\frac{p^{a+1}-1}{p-1}\\cdot\\frac{q^{b+1}-1}{q-1}\\cdots","n":"Ways to write $N$ as a product of two coprime factors: $2^{k-1}$ ($k$ distinct primes)."},{"q":"Ways to write $N$ as product of two factors","f":"\\frac{\\tau(N)}2\\ (N\\ \\text{not a square}),\\qquad\\frac{\\tau(N)+1}2\\ (N\\ \\text{a square})"},{"q":"Exponent of prime $p$ in $n!$ (Legendre)","f":"E_p(n!)=\\left[\\frac np\\right]+\\left[\\frac n{p^2}\\right]+\\left[\\frac n{p^3}\\right]+\\cdots"}]],["Distribution",[{"q":"Dividing $n$ distinct items into groups of sizes $p,q,r$","f":"\\frac{n!}{p!\\,q!\\,r!}\\ (\\text{unequal sizes});\\qquad \\frac{(3p)!}{(p!)^3\\,3!}\\ (\\text{3 equal groups})","n":"Multiply by the number of ways to hand the groups to people ($3!$) if distributing."},{"q":"Identical items into distinct boxes (stars and bars)","f":"x_1+\\cdots+x_r=n,\\ x_i\\ge0:\\ {}^{n+r-1}C_{r-1};\\qquad x_i\\ge1:\\ {}^{n-1}C_{r-1}"},{"q":"Distinct items into distinct boxes, none empty","f":"r^n-{}^rC_1(r-1)^n+{}^rC_2(r-2)^n-\\cdots"},{"q":"Derangements","f":"D_n=n!\\left(1-\\frac1{1!}+\\frac1{2!}-\\cdots+\\frac{(-1)^n}{n!}\\right)","n":"$D_1=0,\\ D_2=1,\\ D_3=2,\\ D_4=9,\\ D_5=44$. Recurrence $D_n=(n-1)(D_{n-1}+D_{n-2})$."},{"q":"Multinomial coefficient – coefficient form","f":"\\text{ways}=\\text{coefficient of } x^n \\text{ in } (1+x+x^2+\\cdots)^r"}]],["Geometry counts",[{"q":"Lines and triangles from n points (no 3 collinear)","f":"\\text{lines}={}^nC_2,\\qquad\\text{triangles}={}^nC_3,\\qquad\\text{diagonals of }n\\text{-gon}={}^nC_2-n","n":"With $m$ collinear: lines ${}^nC_2-{}^mC_2+1$, triangles ${}^nC_3-{}^mC_3$."},{"q":"Rectangles and squares on a chessboard grid","f":"m\\times n\\ \\text{grid lines}:\\ {}^mC_2\\cdot{}^nC_2\\ \\text{rectangles};\\quad 8\\times8\\ \\text{board}: 204\\ \\text{squares},\\ 1296\\ \\text{rectangles}"},{"q":"Points of intersection","f":"n\\ \\text{lines (none parallel, no 3 concurrent)}:\\ {}^nC_2;\\qquad n\\ \\text{circles}:\\ 2\\cdot{}^nC_2"},{"q":"Shortest grid paths","f":"\\text{from }(0,0)\\text{ to }(m,n):\\ {}^{m+n}C_n"}]],["Common results",[{"q":"Principle of inclusion–exclusion","f":"|A\\cup B\\cup C|=\\sum|A|-\\sum|A\\cap B|+|A\\cap B\\cap C|"},{"q":"Number of onto functions $A\\to B$","f":"|A|=n,\\ |B|=m:\\ \\sum_{k=0}^{m}(-1)^k\\binom mk(m-k)^n","n":"Total functions $m^n$; one-one functions ${}^mP_n$ ($n\\le m$)."}]]]}