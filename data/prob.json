{"k":"prob","t":"Probability","cls":"12","u":"Probability & Statistics","s":[["Basics",[{"q":"Classical probability","f":"P(A)=\\frac{n(A)}{n(S)},\\qquad P(A')=1-P(A)","n":"Odds in favour $a:b\\Rightarrow P=\\frac a{a+b}$."},{"q":"Addition theorem","f":"P(A\\cup B)=P(A)+P(B)-P(A\\cap B)","n":"Three events: $\\sum P(A)-\\sum P(A\\cap B)+P(A\\cap B\\cap C)$."},{"q":"Exactly one of A, B","f":"P(A)+P(B)-2P(A\\cap B)","n":"$P(A\\cap B')=P(A)-P(A\\cap B)$; neither: $1-P(A\\cup B)$."},{"q":"Bounds","f":"P(A)+P(B)-1\\le P(A\\cap B)\\le\\min(P(A),P(B))","n":"$\\max(P(A),P(B))\\le P(A\\cup B)\\le\\min(1,P(A)+P(B))$."}]],["Conditional probability",[{"q":"Conditional probability","f":"P(A|B)=\\frac{P(A\\cap B)}{P(B)}","n":"$P(A'|B)=1-P(A|B)$."},{"q":"Multiplication theorem","f":"P(A\\cap B)=P(A)P(B|A)=P(B)P(A|B)"},{"q":"Independent events","f":"P(A\\cap B)=P(A)P(B)","n":"Then $A,B'$; $A',B$; $A',B'$ are also independent. Mutually exclusive events with non-zero probabilities are never independent. Three events need pairwise and triple product conditions."},{"q":"Total probability","f":"P(A)=\\sum_iP(E_i)P(A|E_i)","n":"$E_i$ partition the sample space."},{"q":"Bayes' theorem","f":"P(E_i|A)=\\frac{P(E_i)P(A|E_i)}{\\sum_jP(E_j)P(A|E_j)}"}]],["Random variables",[{"q":"Mean and variance of a discrete random variable","f":"\\mu=E(X)=\\sum x_ip_i,\\qquad\\sigma^2=E(X^2)-\\mu^2=\\sum x_i^2p_i-\\mu^2","n":"$E(aX+b)=aE(X)+b$; $\\operatorname{Var}(aX+b)=a^2\\operatorname{Var}(X)$."},{"q":"Binomial distribution","f":"P(X=r)={}^nC_rp^rq^{n-r},\\qquad\\mu=np,\\quad\\sigma^2=npq","n":"Mode: the integer part of $(n+1)p$ (two modes if $(n+1)p$ is an integer). $P(\\text{at least one})=1-q^n$."},{"q":"Geometric-type (first success on trial $r$)","f":"P(X=r)=q^{r-1}p,\\qquad E(X)=\\frac1p"},{"q":"Poisson (for reference)","f":"P(X=r)=\\frac{e^{-\\lambda}\\lambda^r}{r!},\\quad\\mu=\\sigma^2=\\lambda"}]],["Geometric probability",[{"q":"Geometric probability","f":"P=\\frac{\\text{favourable length/area/volume}}{\\text{total length/area/volume}}"}]],["Common results",[{"q":"Two players alternating, first success wins","f":"P(\\text{first player wins})=\\frac p{1-q^2}=\\frac1{1+q}\\quad(\\text{same } p \\text{ for both})","d":"First player wins on turn 1, 3, 5, …: $p+q^2p+q^4p+\\cdots=\\frac p{1-q^2}$.","n":"General: $P(A\\ \\text{wins})=\\frac{p_1}{1-q_1q_2}$ when A starts."},{"q":"Birthday / at least two same","f":"P=1-\\frac{{}^{365}P_n}{365^n}"},{"q":"Derangement probability","f":"P(\\text{no letter in correct envelope})=\\frac{D_n}{n!}\\approx\\frac1e"},{"q":"Sum of two dice","f":"P(\\text{sum}=s)=\\frac{6-|s-7|}{36},\\quad s=2,\\dots,12"},{"q":"Probability that a quadratic / random choice satisfies a condition","f":"\\text{count favourable pairs over total pairs (often } 36 \\text{ for two dice)}"},{"q":"Independence check for three events","f":"P(A\\cap B\\cap C)=P(A)P(B)P(C)\\ \\text{and all pairs}"}]]]}