{"k":"tri","t":"Properties & Solutions of Triangles","cls":"11","u":"Trigonometry","s":[["Basic rules",[{"q":"Sine rule","f":"\\frac a{\\sin A}=\\frac b{\\sin B}=\\frac c{\\sin C}=2R","d":"Draw the circumcircle; the chord $BC=a$ subtends angle $A$ at the circumference, so $a=2R\\sin A$."},{"q":"Cosine rule","f":"\\cos A=\\frac{b^2+c^2-a^2}{2bc}","n":"$a^2=b^2+c^2-2bc\\cos A$."},{"q":"Projection rule","f":"a=b\\cos C+c\\cos B"},{"q":"Napier's analogy (tangent rule)","f":"\\tan\\frac{B-C}2=\\frac{b-c}{b+c}\\cot\\frac A2"},{"q":"Half-angle formulae","f":"\\sin\\frac A2=\\sqrt{\\frac{(s-b)(s-c)}{bc}},\\quad\\cos\\frac A2=\\sqrt{\\frac{s(s-a)}{bc}},\\quad\\tan\\frac A2=\\sqrt{\\frac{(s-b)(s-c)}{s(s-a)}}","n":"$s=\\frac{a+b+c}2$. Also $\\tan\\frac A2=\\frac{\\Delta}{s(s-a)}=\\frac r{s-a}$."}]],["Area",[{"q":"Area of a triangle","f":"\\Delta=\\tfrac12bc\\sin A=\\sqrt{s(s-a)(s-b)(s-c)}=\\frac{abc}{4R}=rs","n":"$\\sin A=\\frac{2\\Delta}{bc}$."},{"q":"Heron expansion","f":"16\\Delta^2=2a^2b^2+2b^2c^2+2c^2a^2-a^4-b^4-c^4"}]],["Radii",[{"q":"Circumradius","f":"R=\\frac a{2\\sin A}=\\frac{abc}{4\\Delta}"},{"q":"Inradius","f":"r=\\frac\\Delta s=(s-a)\\tan\\frac A2=4R\\sin\\frac A2\\sin\\frac B2\\sin\\frac C2","n":"$r=\\frac{a\\sin\\frac B2\\sin\\frac C2}{\\cos\\frac A2}$."},{"q":"Exradius","f":"r_1=\\frac\\Delta{s-a}=s\\tan\\frac A2=4R\\sin\\frac A2\\cos\\frac B2\\cos\\frac C2"},{"q":"Relations between radii","f":"r_1+r_2+r_3-r=4R,\\qquad\\frac1{r_1}+\\frac1{r_2}+\\frac1{r_3}=\\frac1r,\\qquad r\\,r_1r_2r_3=\\Delta^2","n":"$r_1r_2+r_2r_3+r_3r_1=s^2$."}]],["Centres and lengths",[{"q":"Distances between centres","f":"OI^2=R^2-2Rr,\\qquad OI_1^2=R^2+2Rr_1","n":"Euler: $R\\ge2r$ (equality for equilateral)."},{"q":"Distance of incentre from a vertex","f":"AI=\\frac{r}{\\sin\\frac A2}=4R\\sin\\frac B2\\sin\\frac C2"},{"q":"Median length","f":"m_a=\\frac12\\sqrt{2b^2+2c^2-a^2}","n":"Apollonius: $b^2+c^2=2(m_a^2+\\frac{a^2}4)$."},{"q":"Angle bisector length","f":"AD=\\frac{2bc}{b+c}\\cos\\frac A2","n":"$D$ divides $BC$ in ratio $c:b$."},{"q":"Altitude","f":"h_a=\\frac{2\\Delta}a=b\\sin C=c\\sin B"},{"q":"Distances of orthocentre","f":"AH=2R\\cos A,\\qquad \\text{distance of } H \\text{ from } BC=2R\\cos B\\cos C"},{"q":"Pedal and excentral triangles","f":"\\text{pedal triangle sides}: a\\cos A,\\ b\\cos B,\\ c\\cos C;\\quad\\text{circumradius}=\\tfrac R2","n":"Excentral triangle sides $4R\\cos\\frac A2$ etc.; angles $\\frac\\pi2-\\frac A2$ etc."}]],["Polygons and heights",[{"q":"Regular polygon with n sides of length a","f":"R=\\frac a2\\csc\\frac\\pi n,\\qquad r=\\frac a2\\cot\\frac\\pi n,\\qquad\\text{Area}=\\frac{na^2}4\\cot\\frac\\pi n"},{"q":"Cyclic quadrilateral (Brahmagupta)","f":"\\text{Area}=\\sqrt{(s-a)(s-b)(s-c)(s-d)},\\qquad\\cos B=\\frac{a^2+b^2-c^2-d^2}{2(ab+cd)}"},{"q":"Ambiguous case (given $a,b,A$)","f":"a<b\\sin A:\\ \\text{none};\\ a=b\\sin A:\\ \\text{one (right)};\\ b\\sin A<a<b:\\ \\text{two};\\ a\\ge b:\\ \\text{one}","n":"For acute $A$."},{"q":"m–n theorem","f":"(m+n)\\cot\\theta=m\\cot\\alpha-n\\cot\\beta=n\\cot B-m\\cot C","n":"$D$ divides $BC$ in $m:n$; $\\theta=\\angle ADC$; $\\alpha=\\angle BAD$, $\\beta=\\angle DAC$."}]],["Common results",[{"q":"Right-angle check","f":"a^2+b^2=c^2\\iff C=90^\\circ;\\quad a^2+b^2<c^2\\iff C\\ \\text{obtuse}"},{"q":"In an equilateral triangle","f":"R=\\frac a{\\sqrt3},\\quad r=\\frac a{2\\sqrt3},\\quad\\Delta=\\frac{\\sqrt3}4a^2","n":"$R:r:r_1=2:1:3$."},{"q":"Sum of cotangents","f":"\\cot A+\\cot B+\\cot C=\\frac{a^2+b^2+c^2}{4\\Delta}"},{"q":"Equal-angle shortcut","f":"\\frac{a+b}{c}=\\frac{\\cos\\frac{A-B}2}{\\sin\\frac C2},\\qquad\\frac{a-b}c=\\frac{\\sin\\frac{A-B}2}{\\cos\\frac C2}"}]]]}