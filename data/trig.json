{"k":"trig","t":"Trigonometric Ratios & Identities","cls":"11","u":"Trigonometry","s":[["Basics and graphs",[{"q":"Radian–degree conversion","f":"\\pi\\ \\text{rad}=180^\\circ,\\qquad l=r\\theta","n":"Area of a sector $=\\frac12r^2\\theta$."},{"q":"Pythagorean identities","f":"\\sin^2\\theta+\\cos^2\\theta=1,\\quad 1+\\tan^2\\theta=\\sec^2\\theta,\\quad1+\\cot^2\\theta=\\csc^2\\theta","n":"$\\sec\\theta+\\tan\\theta=\\frac1{\\sec\\theta-\\tan\\theta}$ (useful pair trick)."},{"q":"Signs in quadrants","f":"\\text{I: all}+,\\ \\ \\text{II: }\\sin,\\csc+,\\ \\ \\text{III: }\\tan,\\cot+,\\ \\ \\text{IV: }\\cos,\\sec+","h":"\"All Students Take Coffee\"."},{"q":"Graph of $\\sin x$ and $\\cos x$","f":"\\sin x,\\cos x\\in[-1,1],\\ \\text{period }2\\pi","g":"y=sin(x) | y=cos(x) ; -6.6,6.6,-1.6,1.6"},{"q":"Graph of $\\tan x$","f":"\\tan x\\in\\mathbb R,\\ \\text{period }\\pi,\\ \\text{asymptotes } x=(2n+1)\\tfrac\\pi2","g":"y=tan(x) ; -4.8,4.8,-4,4"},{"q":"Graphs of $\\csc x$, $\\sec x$, $\\cot x$","f":"\\csc x,\\sec x\\in(-\\infty,-1]\\cup[1,\\infty),\\quad\\cot x\\in\\mathbb R","g":"y=1/sin(x) | y=1/cos(x) | y=1/tan(x) ; -6.6,6.6,-4,4"},{"q":"Allied angles (reduction)","f":"\\sin(\\pi-\\theta)=\\sin\\theta,\\ \\cos(\\pi-\\theta)=-\\cos\\theta,\\ \\sin(\\tfrac\\pi2-\\theta)=\\cos\\theta,\\ \\sin(-\\theta)=-\\sin\\theta","n":"Odd multiple of $\\frac\\pi2$: the function changes to its co-function; even multiple: it stays. Sign from the quadrant of the original angle."},{"q":"Standard values","f":"\\sin15^\\circ=\\frac{\\sqrt3-1}{2\\sqrt2},\\quad\\cos15^\\circ=\\frac{\\sqrt3+1}{2\\sqrt2},\\quad\\tan15^\\circ=2-\\sqrt3,\\quad\\tan75^\\circ=2+\\sqrt3"},{"q":"Values for 18°, 36°","f":"\\sin18^\\circ=\\frac{\\sqrt5-1}4,\\qquad\\cos36^\\circ=\\frac{\\sqrt5+1}4","n":"$\\cos18^\\circ=\\frac{\\sqrt{10+2\\sqrt5}}4$, $\\sin36^\\circ=\\frac{\\sqrt{10-2\\sqrt5}}4$.","d":"Let $\\theta=18^\\circ$: $2\\theta=90^\\circ-3\\theta \\Rightarrow \\sin2\\theta=\\cos3\\theta \\Rightarrow 2\\sin\\theta=4\\cos^2\\theta-3$ → $4\\sin^2\\theta+2\\sin\\theta-1=0$."},{"q":"Values for 22.5°, 7.5°","f":"\\tan22.5^\\circ=\\sqrt2-1,\\qquad\\tan67.5^\\circ=\\sqrt2+1","n":"$\\sin22.5^\\circ=\\frac{\\sqrt{2-\\sqrt2}}2$, $\\cos22.5^\\circ=\\frac{\\sqrt{2+\\sqrt2}}2$."}]],["Compound angles",[{"q":"Sine of sum/difference","f":"\\sin(A\\pm B)=\\sin A\\cos B\\pm\\cos A\\sin B"},{"q":"Cosine of sum/difference","f":"\\cos(A\\pm B)=\\cos A\\cos B\\mp\\sin A\\sin B"},{"q":"Tangent of sum/difference","f":"\\tan(A\\pm B)=\\frac{\\tan A\\pm\\tan B}{1\\mp\\tan A\\tan B}","n":"$\\cot(A\\pm B)=\\frac{\\cot A\\cot B\\mp1}{\\cot B\\pm\\cot A}$."},{"q":"Product identities","f":"\\sin(A+B)\\sin(A-B)=\\sin^2A-\\sin^2B,\\qquad\\cos(A+B)\\cos(A-B)=\\cos^2A-\\sin^2B"},{"q":"Tangent of three angles","f":"\\tan(A+B+C)=\\frac{\\sum\\tan A-\\prod\\tan A}{1-\\sum\\tan A\\tan B}"}]],["Multiple and sub-multiple angles",[{"q":"Double angle","f":"\\sin2A=2\\sin A\\cos A=\\frac{2\\tan A}{1+\\tan^2A},\\quad\\cos2A=\\cos^2A-\\sin^2A=\\frac{1-\\tan^2A}{1+\\tan^2A}","n":"$\\cos2A=2\\cos^2A-1=1-2\\sin^2A$; $\\tan2A=\\frac{2\\tan A}{1-\\tan^2A}$."},{"q":"Triple angle","f":"\\sin3A=3\\sin A-4\\sin^3A,\\quad\\cos3A=4\\cos^3A-3\\cos A,\\quad\\tan3A=\\frac{3\\tan A-\\tan^3A}{1-3\\tan^2A}"},{"q":"Half-angle (power reduction)","f":"\\sin^2\\tfrac A2=\\frac{1-\\cos A}2,\\quad\\cos^2\\tfrac A2=\\frac{1+\\cos A}2,\\quad\\tan\\tfrac A2=\\frac{1-\\cos A}{\\sin A}=\\frac{\\sin A}{1+\\cos A}"},{"q":"Product of sines at 60° spacing","f":"\\sin\\theta\\sin(60^\\circ-\\theta)\\sin(60^\\circ+\\theta)=\\tfrac14\\sin3\\theta","n":"Same pattern: $\\cos\\theta\\cos(60^\\circ-\\theta)\\cos(60^\\circ+\\theta)=\\frac14\\cos3\\theta$, $\\tan\\theta\\tan(60^\\circ-\\theta)\\tan(60^\\circ+\\theta)=\\tan3\\theta$."}]],["Sum–product",[{"q":"Sum to product","f":"\\sin C+\\sin D=2\\sin\\tfrac{C+D}2\\cos\\tfrac{C-D}2,\\qquad\\sin C-\\sin D=2\\cos\\tfrac{C+D}2\\sin\\tfrac{C-D}2","n":"$\\cos C+\\cos D=2\\cos\\frac{C+D}2\\cos\\frac{C-D}2$, $\\cos C-\\cos D=-2\\sin\\frac{C+D}2\\sin\\frac{C-D}2$."},{"q":"Product to sum","f":"2\\sin A\\cos B=\\sin(A+B)+\\sin(A-B),\\quad2\\cos A\\cos B=\\cos(A+B)+\\cos(A-B)","n":"$2\\sin A\\sin B=\\cos(A-B)-\\cos(A+B)$."}]],["Series and products",[{"q":"Sum of sines in AP","f":"\\sum_{k=0}^{n-1}\\sin(\\alpha+k\\beta)=\\frac{\\sin\\frac{n\\beta}2}{\\sin\\frac\\beta2}\\sin\\left(\\alpha+\\frac{(n-1)\\beta}2\\right)","n":"For cosines replace the last $\\sin$ with $\\cos$. Hook: (sin of n×half-difference / sin of half-difference) × sin of average angle.","d":"Multiply by $2\\sin\\frac\\beta2$; each term becomes a difference of cosines that telescopes."},{"q":"Product of cosines in GP of angles","f":"\\cos A\\cos2A\\cos4A\\cdots\\cos2^{n-1}A=\\frac{\\sin2^nA}{2^n\\sin A}","d":"Multiply and divide by $2\\sin A$ and use $2\\sin x\\cos x=\\sin2x$ repeatedly."}]],["Range and maxima",[{"q":"Range of $a\\sin\\theta+b\\cos\\theta$","f":"-\\sqrt{a^2+b^2}\\le a\\sin\\theta+b\\cos\\theta\\le\\sqrt{a^2+b^2}","d":"Write $a\\sin\\theta+b\\cos\\theta=\\sqrt{a^2+b^2}\\sin(\\theta+\\phi)$ with $\\tan\\phi=\\frac ba$."},{"q":"Minimum of $a\\tan^2\\theta+b\\cot^2\\theta$","f":"2\\sqrt{ab}\\quad(a,b>0)","n":"Similarly $a\\sin^2\\theta+b\\csc^2\\theta$ has minimum $2\\sqrt{ab}$ only if $a\\ge b$, else $a+b$."}]],["Common results",[{"q":"Conditional identities when $A+B+C=\\pi$","f":"\\tan A+\\tan B+\\tan C=\\tan A\\tan B\\tan C","n":"Also $\\cot\\frac A2\\cot\\frac B2\\cot\\frac C2=\\sum\\cot\\frac A2$ and $\\sum\\tan\\frac A2\\tan\\frac B2=1$."},{"q":"Sine/cosine sums in a triangle","f":"\\sin2A+\\sin2B+\\sin2C=4\\sin A\\sin B\\sin C,\\qquad \\cos2A+\\cos2B+\\cos2C=-1-4\\cos A\\cos B\\cos C","n":"$\\sin A+\\sin B+\\sin C=4\\cos\\frac A2\\cos\\frac B2\\cos\\frac C2$; $\\cos A+\\cos B+\\cos C=1+4\\sin\\frac A2\\sin\\frac B2\\sin\\frac C2$."},{"q":"Squares in a triangle","f":"\\cos^2A+\\cos^2B+\\cos^2C=1-2\\cos A\\cos B\\cos C"},{"q":"Useful products","f":"\\cos20^\\circ\\cos40^\\circ\\cos80^\\circ=\\tfrac18,\\quad\\sin20^\\circ\\sin40^\\circ\\sin80^\\circ=\\tfrac{\\sqrt3}8,\\quad\\tan20^\\circ\\tan40^\\circ\\tan80^\\circ=\\sqrt3"},{"q":"Useful sums","f":"\\cos\\tfrac{2\\pi}7+\\cos\\tfrac{4\\pi}7+\\cos\\tfrac{6\\pi}7=-\\tfrac12,\\qquad\\cos\\tfrac{\\pi}{7}\\cos\\tfrac{2\\pi}7\\cos\\tfrac{4\\pi}7=-\\tfrac18"},{"q":"Bounds","f":"\\sin\\theta<\\theta<\\tan\\theta\\quad(0<\\theta<\\tfrac\\pi2)"}]]]}